# ============================================================
# APPLICATION & SECURITY CONFIG
# ============================================================
PROJECT_NAME="Seven Circle Property API"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-strong-random-secret-key-here-minimum-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================================
# POSTGRESQL DATABASE CONNECTION
# ============================================================
# Replace 'your_password' with your local PostgreSQL postgres password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=scp_realestate
DB_SCHEMA=app

# Standard Async & Sync URLs
DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/scp_realestate"
SYNC_DATABASE_URL="postgresql://postgres:your_password@localhost:5432/scp_realestate"

# ============================================================
# CORS (Frontend URL)
# ============================================================
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ============================================================
# FILE STORAGE
# ============================================================
UPLOAD_DIR="./uploads"
STORAGE_PROVIDER="local"
